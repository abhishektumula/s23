// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model UserAuth{
  id Int @id @default(autoincrement())
  username String @unique 
  password String 
  secureKey String
}

model test{
  id Int @id @default(autoincrement())
  name String
}

model Testmessages{
  id Int @id @default(autoincrement())
  userId Int 
  username String
  message String
  timestamp DateTime @default(now())
}